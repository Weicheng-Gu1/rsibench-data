{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Weicheng-Gu1/rsibench-data/schemas/trajectory-manifest.schema.json",
  "title": "RSIBench trajectory manifest",
  "type": "object",
  "required": [
    "schema_version",
    "published_at_utc",
    "source_run_id",
    "source_commit",
    "subset",
    "bench",
    "model",
    "harness",
    "protocol",
    "score_and_cost",
    "candidate_history",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "published_at_utc": {"type": "string", "format": "date-time"},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subset": {"type": "string", "minLength": 1},
    "bench": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "harness": {"type": "string", "minLength": 1},
    "backend": {"type": ["string", "null"]},
    "study": {
      "oneOf": [
        {
          "type": "object",
          "required": ["family", "condition"],
          "properties": {
            "family": {"const": "editable_surface"},
            "condition": {"enum": ["prompt", "agent-loop", "tool-runtime", "observation", "context", "compaction", "skills-skill-loader", "hooks"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["family", "condition"],
          "properties": {
            "family": {"const": "cognitive_controller"},
            "condition": {"enum": ["findings-only", "targets-only", "review-only", "causal-full"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "protocol": {"type": "object"},
    "score_and_cost": {
      "type": "object",
      "required": ["V_test_A0", "V_test_AT"],
      "properties": {
        "V_test_A0": {"type": "number"},
        "V_test_AT": {"type": "number"},
        "held_out_test_usage": {
          "type": "object",
          "required": [
            "schema_version", "scope", "unit", "task_count",
            "rollouts_per_task", "a0", "a_last", "delta", "pricing"
          ],
          "properties": {
            "schema_version": {"const": 1},
            "scope": {"const": "held_out_test_A0_and_A_last_only"},
            "unit": {"const": "per_test_task_mean"},
            "task_count": {"type": "integer", "minimum": 1},
            "rollouts_per_task": {"const": 3},
            "a0": {"$ref": "#/$defs/testEndpointUsage"},
            "a_last": {"$ref": "#/$defs/testEndpointUsage"},
            "delta": {
              "type": "object",
              "required": ["tokens_per_task", "cost_usd_per_task"],
              "properties": {
                "tokens_per_task": {"type": ["number", "null"]},
                "cost_usd_per_task": {"type": ["number", "null"]}
              },
              "additionalProperties": false
            },
            "pricing": {"type": ["object", "null"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "candidate_history": {
      "type": "object",
      "required": ["schema_version", "policy", "round_count", "accepted_rounds", "candidates"],
      "properties": {
        "schema_version": {"const": 1},
        "policy": {"const": "preserve_every_meta_agent_candidate"},
        "round_count": {"const": 5},
        "accepted_rounds": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 5}},
        "candidates": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["round", "candidate_id", "status", "accepted", "score_status"],
            "properties": {
              "round": {"type": "integer", "minimum": 1, "maximum": 5},
              "candidate_id": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "accepted": {"type": "boolean"},
              "score_status": {"enum": ["scored", "error", "not_scored"]},
              "current_score": {"type": ["number", "null"]},
              "candidate_score": {"type": ["number", "null"]},
              "validation_score": {"type": ["number", "null"]}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "ablations": {
      "type": "object",
      "required": ["policy", "method", "layers"],
      "properties": {
        "policy": {"const": "terminal_changed_modules_only"},
        "method": {"const": "keep_one_changed_module"},
        "layers": {
          "type": "object",
          "properties": {
            "legacy_pi_workspace": {"type": ["object", "null"]},
            "shared_resources": {"type": ["object", "null"]},
            "pi_core_source": {"type": ["object", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "artifact_count": {"type": "integer", "minimum": 0},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "testEndpointUsage": {
      "type": "object",
      "required": [
        "total_tokens", "tokens_per_task", "cost_usd",
        "cost_usd_per_task", "cost_status"
      ],
      "properties": {
        "total_tokens": {"type": "number", "minimum": 0},
        "tokens_per_task": {"type": "number", "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "cost_usd_per_task": {"type": ["number", "null"], "minimum": 0},
        "cost_status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
