{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Weicheng-Gu1/rsibench-data/schemas/trajectory-manifest.schema.json",
  "title": "RSIBench trajectory manifest",
  "type": "object",
  "required": [
    "schema_version",
    "published_at_utc",
    "source_run_id",
    "source_commit",
    "subset",
    "bench",
    "model",
    "harness",
    "protocol",
    "score_and_cost",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "published_at_utc": {"type": "string", "format": "date-time"},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subset": {"type": "string", "minLength": 1},
    "bench": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "harness": {"type": "string", "minLength": 1},
    "backend": {"type": ["string", "null"]},
    "protocol": {"type": "object"},
    "score_and_cost": {"type": "object"},
    "artifact_count": {"type": "integer", "minimum": 0},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}

